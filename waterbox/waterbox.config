{
  "coreName": "PPSSPP",
  "author": "Henrik Rydgard and the PPSSPP team (chimera port: Sergio Martin)",
  "version": "1.0.0",
  "url": "https://github.com/ToolAssisted-run/chimera-core-ppsspp",
  "systemId": "PSP",
  "romFile": "rom",
  "deterministic": true,
  "memoryLayoutMiB": [
    128,
    16,
    64,
    64,
    1024
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invis, plain, mmap. PPSSPP is a big machine: the 256MiB masked PSP address-space arena plus PPSSPP's own heap (softgpu bins, IR blocks, kernel objects) live in sbrk/mmap, and every green-thread stack is 8MiB of mmap arena.",
  "video": {
    "width": 480,
    "height": 272,
    "virtualWidth": 480,
    "virtualHeight": 272,
    "vsyncNumerator": 60000000,
    "vsyncDenominator": 1001001,
    "_vsync_note": "The PSP's exact refresh rate, 59.9400599...Hz.",
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "samplesPerFrame": 8192,
    "_samplesPerFrame_note": "capacity, not the count: the core exports GetAudioSampleCount and hands over the real number each frame (~735 at 44100Hz).",
    "channels": 2,
    "get": "GetAudio"
  },
  "input": {
    "name": "PSP Controller",
    "buttons": [
      "P1 Up",
      "P1 Down",
      "P1 Left",
      "P1 Right",
      "P1 Cross",
      "P1 Circle",
      "P1 Square",
      "P1 Triangle",
      "P1 Start",
      "P1 Select",
      "P1 L",
      "P1 R"
    ],
    "axes": [
      {
        "name": "P1 L-Stick X",
        "min": -128,
        "max": 127,
        "neutral": 0
      },
      {
        "name": "P1 L-Stick Y",
        "min": -128,
        "max": 127,
        "neutral": 0
      }
    ],
    "_axes_note": "Positive Y is up, the natural gamepad passthrough. The frontend feeds these through the SetAxis export before every frame."
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "extensions": {
    ".iso": "PSP",
    ".cso": "PSP",
    ".pbp": "PSP",
    ".elf": "PSP",
    ".prx": "PSP"
  },
  "settings": [
    {
      "name": "cpuCore",
      "display": "CPU Core",
      "description": "How the PSP's MIPS CPU is executed. The IR interpreter is the proven default; the x86 JIT is much faster and runs inside the sandbox like everything else (generated code is ordinary guest memory, captured by savestates). The two can differ in edge cases, so this shapes the machine and movies record it.",
      "type": "enum",
      "options": [
        "ir-interpreter",
        "interpreter",
        "jit"
      ],
      "default": "ir-interpreter",
      "sync": true
    },
    {
      "name": "pspModel",
      "display": "PSP Model",
      "description": "Which machine this is. The PSP-2000 (Slim) has 64MB of RAM, the PSP-1000 has 32MB; a handful of games use the extra memory. Shapes the machine, so changing it reboots the core and movies record it.",
      "type": "enum",
      "options": [
        "psp-1000",
        "psp-2000"
      ],
      "default": "psp-2000",
      "sync": true
    },
    {
      "name": "language",
      "display": "System Language",
      "description": "The console's language system parameter. Games read it at boot to pick their language, so it shapes the machine.",
      "type": "enum",
      "options": [
        "japanese",
        "english",
        "french",
        "spanish",
        "german",
        "italian",
        "dutch",
        "portuguese",
        "russian",
        "korean",
        "chinese-traditional",
        "chinese-simplified"
      ],
      "default": "english",
      "sync": true
    },
    {
      "name": "nickname",
      "display": "Nickname",
      "description": "The console owner's name system parameter. Games read it for save files and default player names.",
      "type": "string",
      "default": "Chimera",
      "sync": true
    },
    {
      "name": "buttonPreference",
      "display": "Confirm Button",
      "description": "Which face button the system treats as confirm - Circle on Japanese consoles, Cross elsewhere. Games read it to lay out their menus.",
      "type": "enum",
      "options": [
        "cross",
        "circle"
      ],
      "default": "cross",
      "sync": true
    },
    {
      "name": "rtcBase",
      "display": "Console Clock",
      "description": "The console's date and time at power-on, as YYYY-MM-DD HH:MM:SS. Games read the RTC for save timestamps, daily events and date-gated content; emulated time advances from this point with emulation, never with the real clock. An unparseable value falls back to the default.",
      "type": "string",
      "default": "2017-05-27 12:44:28",
      "sync": true
    },
    {
      "name": "cpuClock",
      "display": "CPU Clock (MHz)",
      "description": "Lock the emulated CPU to this many MHz; 0 leaves the clock to the game (the hardware boots at 222 and games may raise it to 333). Underclocking and overclocking both change timing, so this shapes the machine.",
      "type": "int",
      "min": 0,
      "max": 333,
      "default": 0,
      "sync": true
    },
    {
      "name": "ioTiming",
      "display": "I/O Timing",
      "description": "How long emulated disc and memory-stick I/O takes: 'fast' completes quickly, 'simulated' models realistic access times, 'umd-slow' models a slow UMD drive. (Upstream's host-clock timing mode is nondeterministic and deliberately not offered.)",
      "type": "enum",
      "options": [
        "fast",
        "simulated",
        "umd-slow"
      ],
      "default": "fast",
      "sync": true
    },
    {
      "name": "timeZone",
      "display": "Time Zone (minutes)",
      "description": "The console's UTC offset in minutes (-720..840), a system parameter games read alongside the clock.",
      "type": "int",
      "min": -720,
      "max": 840,
      "default": 0,
      "sync": true
    },
    {
      "name": "daylightSavings",
      "display": "Daylight Savings",
      "description": "The daylight-savings system parameter games can read.",
      "type": "bool",
      "default": false,
      "sync": true
    },
    {
      "name": "firmwareVersion",
      "display": "Firmware Version",
      "description": "The system software version games see (660 = 6.60). Some games check it at boot.",
      "type": "int",
      "min": 100,
      "max": 999,
      "default": 660,
      "sync": true
    },
    {
      "name": "macAddress",
      "display": "MAC Address",
      "description": "The console's WLAN MAC address as XX:XX:XX:XX:XX:XX. Games read it as a console identity and some seed randomness from it.",
      "type": "string",
      "default": "12:34:56:78:9A:BC",
      "sync": true
    },
    {
      "name": "dateFormat",
      "display": "Date Format",
      "description": "The date-format system parameter games read for display.",
      "type": "enum",
      "options": [
        "yyyy-mm-dd",
        "mm-dd-yyyy",
        "dd-mm-yyyy"
      ],
      "default": "yyyy-mm-dd",
      "sync": true
    },
    {
      "name": "timeFormat",
      "display": "Time Format",
      "description": "The time-format system parameter games read for display.",
      "type": "enum",
      "options": [
        "24h",
        "12h"
      ],
      "default": "24h",
      "sync": true
    },
    {
      "name": "parentalLevel",
      "display": "Parental Level",
      "description": "The parental-control level system parameter (0..11). Some games gate content on it.",
      "type": "int",
      "min": 0,
      "max": 11,
      "default": 9,
      "sync": true
    },
    {
      "name": "funcReplacements",
      "display": "HLE Function Replacements",
      "description": "Replace known functions (memcpy and friends) with fast host implementations. On matches PPSSPP's default; off is closer to hardware timing.",
      "type": "bool",
      "default": true,
      "sync": true
    },
    {
      "name": "encryptSave",
      "display": "Encrypt Savedata",
      "description": "Kirk-encrypt savedata like a real console. Turning it off makes saves inspectable but no longer hardware-shaped.",
      "type": "bool",
      "default": true,
      "sync": true
    }
  ],
  "firmware": [
    {
      "id": "ltn0.pgf",
      "display": "System Font ltn0 (Latin sans-serif regular)",
      "description": "The console's sans-serif regular Latin font. Dump it from your own console's flash0:/font; a real dump is exactly 69108 bytes (the size a real console reports, recorded from hardware), and a file of any other size is refused as not being this font. Optional: without it the core uses the free replacement font it ships, which has different glyphs and metrics - a different machine, recorded in movies either way.",
      "size": 69108,
      "sha1": [],
      "required": false
    },
    {
      "id": "ltn1.pgf",
      "display": "System Font ltn1 (Latin serif regular)",

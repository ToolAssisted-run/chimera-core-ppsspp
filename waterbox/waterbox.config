{
  "coreName": "PPSSPP",
  "author": "Henrik Rydgard and the PPSSPP team (chimera port: Sergio Martin)",
  "version": "1.0.0",
  "url": "https://github.com/ToolAssisted-run/chimera-core-ppsspp",
  "systemId": "PSP",
  "romFile": "rom",
  "deterministic": true,
  "memoryLayoutMiB": [
    128,
    16,
    64,
    64,
    1024
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invis, plain, mmap. PPSSPP is a big machine: the 256MiB masked PSP address-space arena plus PPSSPP's own heap (softgpu bins, IR blocks, kernel objects) live in sbrk/mmap, and every green-thread stack is 8MiB of mmap arena.",
  "video": {
    "width": 480,
    "height": 272,
    "virtualWidth": 480,
    "virtualHeight": 272,
    "vsyncNumerator": 60000000,
    "vsyncDenominator": 1001001,
    "_vsync_note": "The PSP's exact refresh rate, 59.9400599...Hz.",
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "samplesPerFrame": 8192,
    "_samplesPerFrame_note": "capacity, not the count: the core exports GetAudioSampleCount and hands over the real number each frame (~735 at 44100Hz).",
    "channels": 2,
    "get": "GetAudio"
  },
  "input": {
    "name": "PSP Controller",
    "buttons": [
      "P1 Up",
      "P1 Down",
      "P1 Left",
      "P1 Right",
      "P1 Cross",
      "P1 Circle",
      "P1 Square",
      "P1 Triangle",
      "P1 Start",
      "P1 Select",
      "P1 L",
      "P1 R"
    ],
    "axes": [
      {
        "name": "P1 L-Stick X",
        "min": -128,
        "max": 127,
        "neutral": 0
      },
      {
        "name": "P1 L-Stick Y",
        "min": -128,
        "max": 127,
        "neutral": 0
      }
    ],
    "_axes_note": "Positive Y is up, the natural gamepad passthrough. The frontend feeds these through the SetAxis export before every frame."
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "extensions": {
    ".iso": "PSP",
    ".cso": "PSP",
    ".pbp": "PSP",
    ".elf": "PSP",
    ".prx": "PSP"
  },
  "settings": [
    {
      "name": "cpuCore",
      "display": "CPU Core",
      "description": "How the PSP's MIPS CPU is executed. The IR interpreter is the proven default; the x86 JIT is much faster and runs inside the sandbox like everything else (generated code is ordinary guest memory, captured by savestates). The two can differ in edge cases, so this shapes the machine and movies record it.",
      "type": "enum",
      "options": [
        "ir-interpreter",
        "interpreter",
        "jit"
      ],
      "default": "ir-interpreter",
      "sync": true
    },
    {
      "name": "pspModel",
      "display": "PSP Model",
      "description": "Which machine this is. The PSP-2000 (Slim) has 64MB of RAM, the PSP-1000 has 32MB; a handful of games use the extra memory. Shapes the machine, so changing it reboots the core and movies record it.",
      "type": "enum",
      "options": [
        "psp-1000",
        "psp-2000"
      ],
      "default": "psp-2000",
      "sync": true
    },
    {
      "name": "language",
      "display": "System Language",
      "description": "The console's language system parameter. Games read it at boot to pick their language, so it shapes the machine.",
      "type": "enum",
      "options": [
        "japanese",
        "english",
        "french",
        "spanish",
        "german",
        "italian",
        "dutch",
        "portuguese",
        "russian",
        "korean",
        "chinese-traditional",
        "chinese-simplified"
      ],
      "default": "english",
      "sync": true
    },
    {
      "name": "nickname",
      "display": "Nickname",
      "description": "The console owner's name system parameter. Games read it for save files and default player names.",
      "type": "string",
      "default": "Chimera",
      "sync": true
    },
    {
      "name": "buttonPreference",
      "display": "Confirm Button",
      "description": "Which face button the system treats as confirm - Circle on Japanese consoles, Cross elsewhere. Games read it to lay out their menus.",
      "type": "enum",
      "options": [
        "cross",
        "circle"
      ],
      "default": "cross",
      "sync": true
    }
  ]
}

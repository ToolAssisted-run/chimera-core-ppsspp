{
  "coreName": "PPSSPP",
  "author": "Henrik Rydgard and the PPSSPP team (chimera port: Sergio Martin)",
  "version": "1.0.0",
  "url": "https://github.com/ToolAssisted-run/chimera-core-ppsspp",
  "systemId": "PSP",
  "systemNames": {
    "PSP": "PlayStation Portable"
  },
  "romFile": "rom",
  "deterministic": true,
  "memoryLayoutMiB": [
    128,
    16,
    64,
    64,
    1024
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invis, plain, mmap. PPSSPP is a big machine: the 256MiB masked PSP address-space arena plus PPSSPP's own heap (softgpu bins, IR blocks, kernel objects) live in sbrk/mmap, and every green-thread stack is 8MiB of mmap arena.",
  "video": {
    "greenzoneSurvivesReload": true,
    "_comment_greenzone": "TRUE: a project's greenzone this core drew on a GPU may be loaded by a later session (docs/gpu-bridge.md in Chimera, 'Keeping the greenzone across sessions'). Measured 2026-09-16: Ridge Racer, 1000 frames, the greenzone written at frame 900 and loaded in a fresh process; frame 999 identical (0 of 130,560 pixels differ), no guest death. Until 2026-10-18 this was PPSSPP's name on a list in Chimera.",
    "width": 480,
    "height": 272,
    "virtualWidth": 480,
    "virtualHeight": 272,
    "vsyncNumerator": 60000,
    "vsyncDenominator": 1001,
    "_vsync_note": "The PSP's refresh rate as PPSSPP models it: sceDisplay's vblank period is 1.001/60 of a second, so 60/1.001 = 59.94005994...Hz. The same NTSC ratio a PS2 and a Dreamcast run at. GetVsyncNumerator/Denominator in waterbox.cpp say the same thing and are what the engine actually reads; these are the answer for a frontend that asks the package instead.",
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "samplesPerFrame": 8192,
    "_samplesPerFrame_note": "capacity, not the count: the core exports GetAudioSampleCount and hands over the real number each frame (~735 at 44100Hz).",
    "channels": 2,
    "get": "GetAudio"
  },
  "input": {
    "name": "PSP Controller",
    "buttons": [
      "P1 Up",
      "P1 Down",
      "P1 Left",
      "P1 Right",
      "P1 Cross",
      "P1 Circle",
      "P1 Square",
      "P1 Triangle",
      "P1 Start",
      "P1 Select",
      "P1 L",
      "P1 R"
    ],
    "mnemonics": {
      "Up": "U",
      "Down": "D",
      "Left": "L",
      "Right": "R",
      "Cross": "X",
      "Circle": "O",
      "Square": "Q",
      "Triangle": "T",
      "Start": "S",
      "Select": "s",
      "L": "l",
      "R": "r"
    },
    "axes": [
      {
        "name": "P1 L-Stick X",
        "min": -128,
        "max": 127,
        "neutral": 0,
        "header": "LSX"
      },
      {
        "name": "P1 L-Stick Y",
        "min": -128,
        "max": 127,
        "neutral": 0,
        "header": "LSY"
      }
    ],
    "_axes_note": "Positive Y is up, the natural gamepad passthrough. The frontend feeds these through the SetAxis export before every frame."
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "extensions": {
    ".iso": "PSP",
    ".cso": "PSP",
    ".pbp": "PSP",
    ".elf": "PSP",
    ".prx": "PSP"
  },
  "settings": [
    {
      "name": "cpuCore",
      "display": "setting.cpucore",
      "description": "setting.cpucore.about",
      "type": "enum",
      "options": [
        "ir-interpreter",
        "interpreter",
        "jit"
      ],
      "default": "jit"
    },
    {
      "name": "renderer",
      "display": "setting.renderer",
      "description": "setting.renderer.about",
      "type": "enum",
      "options": [
        "software",
        "vulkan-hw"
      ],
      "default": "software"
    },
    {
      "name": "pspModel",
      "display": "setting.pspmodel",
      "description": "setting.pspmodel.about",
      "type": "enum",
      "options": [
        "psp-1000",
        "psp-2000"
      ],
      "default": "psp-2000"
    },
    {
      "name": "language",
      "display": "setting.language",
      "description": "setting.language.about",
      "type": "enum",
      "options": [
        "japanese",
        "english",
        "french",
        "spanish",
        "german",
        "italian",
        "dutch",
        "portuguese",
        "russian",
        "korean",
        "chinese-traditional",
        "chinese-simplified"
      ],
      "default": "english"
    },
    {
      "name": "nickname",
      "display": "setting.nickname",
      "description": "setting.nickname.about",
      "type": "string",
      "default": "Chimera"
    },
    {
      "name": "buttonPreference",
      "display": "setting.buttonpreference",
      "description": "setting.buttonpreference.about",
      "type": "enum",
      "options": [
        "cross",
        "circle"
      ],
      "default": "cross"
    },
    {
      "name": "rtcBase",
      "display": "setting.rtcbase",
      "description": "setting.rtcbase.about",
      "type": "string",
      "default": "2017-05-27 12:44:28"
    },
    {
      "name": "cpuClock",
      "display": "setting.cpuclock",
      "description": "setting.cpuclock.about",
      "type": "int",
      "min": 0,
      "max": 333,
      "default": 0
    },
    {
      "name": "ioTiming",
      "display": "setting.iotiming",
      "description": "setting.iotiming.about",
      "type": "enum",
      "options": [
        "fast",
        "simulated",
        "umd-slow"
      ],
      "default": "fast"
    },
    {
      "name": "timeZone",
      "display": "setting.timezone",
      "description": "setting.timezone.about",
      "type": "int",
      "min": -720,
      "max": 840,
      "default": 0
    },
    {
      "name": "daylightSavings",
      "display": "setting.daylightsavings",
      "description": "setting.daylightsavings.about",
      "type": "bool",
      "default": false
    },
    {
      "name": "firmwareVersion",
      "display": "setting.firmwareversion",
      "description": "setting.firmwareversion.about",
      "type": "int",
      "min": 100,
      "max": 999,
      "default": 660
    },
    {
      "name": "macAddress",
      "display": "setting.macaddress",
      "description": "setting.macaddress.about",
      "type": "string",
      "default": "12:34:56:78:9A:BC"
    },
    {
      "name": "dateFormat",
      "display": "setting.dateformat",
      "description": "setting.dateformat.about",
      "type": "enum",
      "options": [
        "yyyy-mm-dd",
        "mm-dd-yyyy",
        "dd-mm-yyyy"
      ],
      "default": "yyyy-mm-dd"
    },
    {
      "name": "timeFormat",
      "display": "setting.timeformat",
      "description": "setting.timeformat.about",
      "type": "enum",
      "options": [
        "24h",
        "12h"
      ],
      "default": "24h"
    },
    {
      "name": "parentalLevel",
      "display": "setting.parentallevel",
      "description": "setting.parentallevel.about",
      "type": "int",
      "min": 0,
      "max": 11,
      "default": 9
    },
    {
      "name": "funcReplacements",
      "display": "setting.funcreplacements",
      "description": "setting.funcreplacements.about",
      "type": "bool",
      "default": true
    },
    {
      "name": "encryptSave",
      "display": "setting.encryptsave",
      "description": "setting.encryptsave.about",
      "type": "bool",
      "default": true
    },
    {
      "name": "fontSource",
      "display": "setting.fontsource",
      "description": "setting.fontsource.about",
      "type": "enum",
      "options": [
        "bundled",
        "sony"
      ],
      "default": "bundled"
    }
  ],

+
+void VulkanPushPool::ChimeraFlush() {
+	for (auto &block : blocks_) {
+		// A block that is started again (BeginFrame, NextBlock) starts unflushed.
+		// It is not enough to notice that it holds less than was flushed: a
+		// frame that writes MORE than the one before would then have only its
+		// tail flushed, and the card would draw the head with the last frame's
+		// vertices (Crash Tag Team Racing's title screen did).
+		if (block.used < block.chimeraFlushed)
+			block.chimeraFlushed = 0;
+		if (block.used > block.chimeraFlushed) {
+			vmaFlushAllocation(vulkan_->Allocator(), block.allocation, block.chimeraFlushed, block.used - block.chimeraFlushed);
+			block.chimeraFlushed = block.used;
+		}
+	}
+}

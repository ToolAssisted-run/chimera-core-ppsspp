+// chimera: see FramebufferManagerCommon.h
+namespace {
+constexpr u64 CHIMERA_FB_MAGIC = 0x3142465053504843ull;
+constexpr u32 CHIMERA_FB_MAX = 256;
+struct ChimeraFbHeader {
+	u64 magic;
+	u32 count;
+	u32 unused;
+	u64 end;  // bytes of pixels in use
+};
+struct ChimeraFbRecord {
+	u64 owner;  // the VirtualFramebuffer
+	u64 offset;
+	u64 bytes;
+	u32 width;
+	u32 height;
+};
+constexpr size_t CHIMERA_FB_TABLE = sizeof(ChimeraFbHeader) + CHIMERA_FB_MAX * sizeof(ChimeraFbRecord);
+}  // namespace
+
+void FramebufferManagerCommon::ChimeraSaveFramebufs(u8 *block, size_t blockBytes, u8 *scratch, size_t scratchBytes) {
+	if (!block || !scratch || !draw_ || blockBytes <= CHIMERA_FB_TABLE || !useBufferedRendering_)
+		return;
+	ChimeraFbRecord fresh[CHIMERA_FB_MAX];
+	u32 count = 0;
+	u64 end = 0;
+	u8 *const pixels = block + CHIMERA_FB_TABLE;
+	const size_t room = blockBytes - CHIMERA_FB_TABLE;
+	for (VirtualFramebuffer *vfb : vfbs_) {
+		if (!vfb->fbo || count == CHIMERA_FB_MAX)
+			continue;
+		const u32 w = vfb->renderWidth, h = vfb->renderHeight;
+		const u64 bytes = (u64)w * h * 4;
+		if (bytes == 0 || bytes > scratchBytes || end + bytes > room)
+			continue;
+		// through the scratch block, and written only where it differs: a
+		// framebuffer nothing drew into costs the next state nothing
+		if (!draw_->CopyFramebufferToMemory(vfb->fbo, Draw::Aspect::COLOR_BIT, 0, 0, w, h, Draw::DataFormat::R8G8B8A8_UNORM, scratch, w, Draw::ReadbackMode::BLOCK, "chimera: before a state"))
+			continue;
+		if (memcmp(pixels + end, scratch, (size_t)bytes) != 0)
+			memcpy(pixels + end, scratch, (size_t)bytes);
+		ChimeraFbRecord rec{};
+		rec.owner = (u64)(uintptr_t)vfb;
+		rec.offset = end;
+		rec.bytes = bytes;
+		rec.width = w;
+		rec.height = h;
+		fresh[count++] = rec;
+		end += bytes;
+	}
+	// reading a framebuffer back ended whatever pass was open
+	if (currentRenderVfb_ && currentRenderVfb_->fbo)
+		draw_->BindFramebufferAsRenderTarget(currentRenderVfb_->fbo, { Draw::RPAction::KEEP, Draw::RPAction::KEEP, Draw::RPAction::KEEP }, "chimera: after the copy");
+	gstate_c.Dirty(DIRTY_ALL_RENDER_STATE);
+
+	ChimeraFbHeader header{};
+	header.magic = CHIMERA_FB_MAGIC;
+	header.count = count;
+	header.end = end;
+	if (memcmp(block, &header, sizeof(header)) != 0)
+		memcpy(block, &header, sizeof(header));
+	if (count != 0 && memcmp(block + sizeof(header), fresh, count * sizeof(ChimeraFbRecord)) != 0)
+		memcpy(block + sizeof(header), fresh, count * sizeof(ChimeraFbRecord));
+}
+
+void FramebufferManagerCommon::ChimeraRestoreFramebufs(const u8 *block, size_t blockBytes, bool usable) {
+	if (!draw_ || !useBufferedRendering_)
+		return;
+	const ChimeraFbHeader *header = (const ChimeraFbHeader *)block;
+	const ChimeraFbRecord *records = block ? (const ChimeraFbRecord *)(block + sizeof(ChimeraFbHeader)) : nullptr;
+	if (!block || blockBytes <= CHIMERA_FB_TABLE || header->magic != CHIMERA_FB_MAGIC || header->count > CHIMERA_FB_MAX)
+		usable = false;
+	const u8 *const pixels = block ? block + CHIMERA_FB_TABLE : nullptr;
+	const size_t room = blockBytes > CHIMERA_FB_TABLE ? blockBytes - CHIMERA_FB_TABLE : 0;
+
+	textureCache_->ForgetLastTexture();
+	for (VirtualFramebuffer *vfb : vfbs_) {
+		if (vfb->fbo || vfb->renderWidth == 0 || vfb->renderHeight == 0)
+			continue;
+		char tag[128];
+		FormatFramebufferName(vfb, tag, sizeof(tag));
+		vfb->fbo = draw_->CreateFramebuffer({ vfb->renderWidth, vfb->renderHeight, 1, GetFramebufferLayers(), msaaLevel_, true, tag });
+		if (!vfb->fbo)
+			continue;
+		draw_->BindFramebufferAsRenderTarget(vfb->fbo, { Draw::RPAction::CLEAR, Draw::RPAction::CLEAR, Draw::RPAction::CLEAR }, "chimera: after a load");
+		const ChimeraFbRecord *rec = nullptr;
+		for (u32 i = 0; usable && i < header->count; i++) {
+			if (records[i].owner == (u64)(uintptr_t)vfb) {
+				rec = &records[i];
+				break;
+			}
+		}
+		if (!rec || rec->width != vfb->renderWidth || rec->height != vfb->renderHeight ||
+			rec->bytes != (u64)rec->width * rec->height * 4 || rec->offset + rec->bytes > room)
+			continue;
+		// the carried pixels, as a texture of the framebuffer's own size, drawn over it one for one
+		Draw::Texture *tex = MakePixelTexture(pixels + rec->offset, GE_FORMAT_8888, rec->width, rec->width, rec->height);
+		if (!tex)
+			continue;
+		SetViewport2D(0, 0, vfb->renderWidth, vfb->renderHeight);
+		draw_->SetScissorRect(0, 0, vfb->renderWidth, vfb->renderHeight);
+		draw_->BindTextures(0, 1, &tex, Draw::TextureBindFlags::VULKAN_BIND_ARRAY);
+		DrawActiveTexture(0, 0, vfb->bufferWidth, vfb->bufferHeight, vfb->bufferWidth, vfb->bufferHeight,
+			0.0f, 0.0f, 1.0f, 1.0f, ROTATION_LOCKED_HORIZONTAL, DRAWTEX_NEAREST);
+		draw_->Invalidate(InvalidationFlags::CACHED_RENDER_STATE);
+	}
+	if (currentRenderVfb_ && currentRenderVfb_->fbo)
+		draw_->BindFramebufferAsRenderTarget(currentRenderVfb_->fbo, { Draw::RPAction::KEEP, Draw::RPAction::KEEP, Draw::RPAction::KEEP }, "chimera: after a load");
+	gstate_c.Dirty(DIRTY_ALL);
+}

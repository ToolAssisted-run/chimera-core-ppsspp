 {
 	// This is the base time, the only case we use gettimeofday() for.
 	// Everything else is relative to that, "virtual time."
+#ifdef CHIMERA_WATERBOX
+	// Deterministic machine: the RTC base comes from the "rtcBase" sync
+	// setting (default: the sandbox epoch, 2017-05-27T12:44:28Z), so the
+	// emulated calendar is a pure function of emulation and the movie.
+	{
+		extern int64_t Chimera_RtcBaseSeconds;
+		rtcBaseTime.tv_sec = (s64)Chimera_RtcBaseSeconds;
+		rtcBaseTime.tv_usec = 0;
+	}
+#else
 	timeval tv;
 	gettimeofday(&tv, NULL);
 	rtcBaseTime.tv_sec = tv.tv_sec;
 	rtcBaseTime.tv_usec = 0;
+#endif
 	// Precalculate the current time in microseconds (rtcMagicOffset is offset to 1970.)
 	RtcUpdateBaseTicks();
 }
